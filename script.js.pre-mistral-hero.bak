/* ==========================================================================
   THE BLANK STATE — Digital Growth Company
   Interactive Functionality & WhatsApp Lead Automation
   ========================================================================== */

document.addEventListener('DOMContentLoaded', () => {
    initMobileNav();
    initSmoothScroll();
    initServiceTabs();
    initKnowMoreLinks();
    initConsultationForm();
    initActiveNavScroll();
    initScrollReveal();
    initShapeDividers();
    initSplitHeadings();
    initDoodles();
    initWorkFilters();
    initEcosystem();
    initFaqAccordion();
    initYear();
    initHeroStrings();
    initServiceIndex();
    initBrandBand();
});

/* --------------------------------------------------------------------------
   Mobile Navigation Toggle
   -------------------------------------------------------------------------- */
function initMobileNav() {
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const navLinks = document.getElementById('navLinks');

    if (!mobileMenuBtn || !navLinks) return;

    mobileMenuBtn.addEventListener('click', () => {
        navLinks.classList.toggle('nav-open');
        const isOpen = navLinks.classList.contains('nav-open');
        mobileMenuBtn.setAttribute('aria-expanded', isOpen);
    });

    // Close mobile menu when clicking on any link
    navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
            navLinks.classList.remove('nav-open');
        });
    });
}

/* --------------------------------------------------------------------------
   FAQ Accordion
   -------------------------------------------------------------------------- */
function initFaqAccordion() {
    const items = document.querySelectorAll('.faq-item');
    if (!items.length) return;

    items.forEach(item => {
        const question = item.querySelector('.faq-question');
        const answer = item.querySelector('.faq-answer');
        if (!question || !answer) return;

        question.addEventListener('click', () => {
            const isOpen = item.classList.contains('open');

            items.forEach(other => {
                other.classList.remove('open');
                const otherAnswer = other.querySelector('.faq-answer');
                const otherQuestion = other.querySelector('.faq-question');
                if (otherAnswer) otherAnswer.style.maxHeight = null;
                if (otherQuestion) otherQuestion.setAttribute('aria-expanded', 'false');
            });

            if (!isOpen) {
                item.classList.add('open');
                answer.style.maxHeight = answer.scrollHeight + 'px';
                question.setAttribute('aria-expanded', 'true');
            }
        });
    });
}

/* --------------------------------------------------------------------------
   "Know More" links — jump from service feature rows into detail tabs
   -------------------------------------------------------------------------- */
function initKnowMoreLinks() {
    document.querySelectorAll('[data-tab-link]').forEach(link => {
        link.addEventListener('click', (event) => {
            event.preventDefault();
            const tabKey = link.getAttribute('data-tab-link');
            const tabBtn = document.querySelector(`.service-tab[data-tab="${tabKey}"]`);
            if (tabBtn) tabBtn.click();
            const tabsWrapper = document.querySelector('.service-tabs-wrapper');
            if (tabsWrapper) {
                const header = document.querySelector('.navbar');
                const offset = (header?.getBoundingClientRect().height || 78) + 16;
                const top = tabsWrapper.getBoundingClientRect().top + window.scrollY - offset;
                window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
            }
        });
    });
}

/* --------------------------------------------------------------------------
   Smooth anchor scrolling with sticky-header offset
   -------------------------------------------------------------------------- */
function initSmoothScroll() {
    document.querySelectorAll('a[href^="#"]:not([href="#"])').forEach(link => {
        link.addEventListener('click', (event) => {
            const targetId = link.getAttribute('href');
            const target = targetId ? document.querySelector(targetId) : null;
            if (!target) return;
            event.preventDefault();
            const header = document.querySelector('.navbar');
            const offset = (header?.getBoundingClientRect().height || 78) + 16;
            const targetTop = target.getBoundingClientRect().top + window.scrollY - offset;
            window.history.replaceState(null, '', targetId);
            window.scrollTo({ top: Math.max(0, targetTop), behavior: 'smooth' });
        });
    });
}

/* --------------------------------------------------------------------------
   Service Tabs Switching
   -------------------------------------------------------------------------- */
function initServiceTabs() {
    const tabButtons = document.querySelectorAll('.service-tab');
    const tabPanels = document.querySelectorAll('.tab-panel');

    if (!tabButtons.length || !tabPanels.length) return;

    tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            const targetTab = btn.getAttribute('data-tab');

            // Deactivate all buttons
            tabButtons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            // Switch active panel
            tabPanels.forEach(panel => {
                panel.classList.remove('active');
                if (panel.id === `tab-${targetTab}`) {
                    panel.classList.add('active');
                }
            });
        });
    });

    // Support deep-linking via URL hash (e.g. #tab-sell or #services-sell)
    const hash = window.location.hash;
    if (hash) {
        if (hash.includes('sell') || hash.includes('ecommerce')) {
            switchTab('sell');
        } else if (hash.includes('advertise') || hash.includes('ads')) {
            switchTab('advertise');
        } else if (hash.includes('seo') || hash.includes('maps')) {
            switchTab('seo');
        } else if (hash.includes('social')) {
            switchTab('social');
        }
    }

    function switchTab(tabKey) {
        const btn = document.querySelector(`.service-tab[data-tab="${tabKey}"]`);
        if (btn) btn.click();
    }
}

/* --------------------------------------------------------------------------
   Consultation Form -> Direct WhatsApp Dispatch
   -------------------------------------------------------------------------- */
function initConsultationForm() {
    const form = document.getElementById('consultationForm');
    if (!form) return;

    form.addEventListener('submit', (e) => {
        e.preventDefault();

        const name = document.getElementById('clientName')?.value.trim() || 'N/A';
        const company = document.getElementById('clientCompany')?.value.trim() || 'N/A';
        const phone = document.getElementById('clientPhone')?.value.trim() || 'N/A';
        const email = document.getElementById('clientEmail')?.value.trim() || 'N/A';
        const message = document.getElementById('clientMessage')?.value.trim() || 'None';

        // Gather checked services
        const checkedServices = [];
        const checkboxes = form.querySelectorAll('input[name="services"]:checked');
        checkboxes.forEach(cb => checkedServices.push(cb.value));
        const servicesStr = checkedServices.length > 0 ? checkedServices.join(', ') : 'General Growth Consultation';

        // Formulate WhatsApp message text
        const textLines = [
            `*New Growth Inquiry — The Blank State Website*`,
            `-------------------------------------------`,
            `*Client Name:* ${name}`,
            `*Company / Business:* ${company}`,
            `*Phone:* ${phone}`,
            `*Email:* ${email}`,
            `*Services Needed:* ${servicesStr}`,
            `*Message / Goals:* ${message}`,
            `-------------------------------------------`,
            `_Sent via theblankstate.com consultation portal_`
        ];

        const encodedText = encodeURIComponent(textLines.join('\n'));
        const targetWhatsAppNumber = '918511410817';
        const whatsappUrl = `https://wa.me/${targetWhatsAppNumber}?text=${encodedText}`;

        // Open WhatsApp in new tab
        window.open(whatsappUrl, '_blank');
    });
}

/* --------------------------------------------------------------------------
   Active Nav Link Highlighting on Scroll
   -------------------------------------------------------------------------- */
function initActiveNavScroll() {
    const sections = document.querySelectorAll('section[id], header[id]');
    const navLinks = document.querySelectorAll('.nav-links a[href^="#"]');

    if (!sections.length || !navLinks.length) return;

    window.addEventListener('scroll', () => {
        let currentSectionId = '';
        const scrollPosition = window.scrollY + 120;

        sections.forEach(section => {
            const sectionTop = section.offsetTop;
            const sectionHeight = section.offsetHeight;

            if (scrollPosition >= sectionTop && scrollPosition < sectionTop + sectionHeight) {
                currentSectionId = section.getAttribute('id');
            }
        });

        navLinks.forEach(link => {
            link.classList.remove('active');
            const href = link.getAttribute('href');
            if (href === `#${currentSectionId}`) {
                link.classList.add('active');
            }
        });
    });
}

/* --------------------------------------------------------------------------
   Scroll-triggered reveal motion
   -------------------------------------------------------------------------- */
function initScrollReveal() {
    const revealTargets = document.querySelectorAll(
        '.service-row, .pillar-card, .service-feature-card, .process-step-item, .why-card, .quote-card, .eco-node'
    );
    if (!revealTargets.length) return;

    revealTargets.forEach((element, index) => {
        element.classList.add('reveal-on-scroll');
        element.style.setProperty('--reveal-delay', `${Math.min(index % 6, 5) * 70}ms`);
    });

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        revealTargets.forEach(element => element.classList.add('is-visible'));
        return;
    }

    const observer = new IntersectionObserver((entries, currentObserver) => {
        entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            currentObserver.unobserve(entry.target);
        });
    }, { threshold: 0.12, rootMargin: '0px 0px -36px 0px' });

    revealTargets.forEach(element => observer.observe(element));
}

/* --------------------------------------------------------------------------
   Current Year in Footer
   -------------------------------------------------------------------------- */
function initYear() {
    const yearEl = document.getElementById('currentYear');
    if (yearEl) {
        yearEl.textContent = new Date().getFullYear();
    }
}


/* --------------------------------------------------------------------------
   Section shape dividers (wave / zigzag / diagonal / steps / scallop)
   -------------------------------------------------------------------------- */
function initShapeDividers() {
    const dividers = document.querySelectorAll('.section-divider[data-shape]');
    if (!dividers.length) return;

    // Match the neighbouring sections' own background so no seam line shows
    const solidBg = el => {
        if (!el) return null;
        const c = getComputedStyle(el).backgroundColor;
        return (!c || c === 'transparent' || c === 'rgba(0, 0, 0, 0)') ? null : c;
    };

    const W = 1440, H = 104, BAND = 30;

    // Smooth sine wave: sampled at high resolution so the crest reads as a curve
    const wave = (amp = 24, cycles = 2.25, mid = 46) => {
        const steps = 120;
        const pts = [];
        for (let i = 0; i <= steps; i++) {
            const x = (i / steps) * W;
            const y = mid + amp * Math.sin((i / steps) * Math.PI * 2 * cycles - Math.PI / 2);
            pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
        }
        return `M${pts.join(' L')} L${W},${H} L0,${H} Z`;
    };

    const zigzag = () => {
        const count = 18, step = W / count;
        const pts = [];
        for (let i = 0; i <= count; i++) pts.push(`${(i * step).toFixed(1)},${i % 2 === 0 ? 58 : 22}`);
        return `M${pts.join(' L')} L${W},${H} L0,${H} Z`;
    };

    const diagonal = () => `M0,64 L${W},18 L${W},${H} L0,${H} Z`;

    const steps = () => {
        const count = 7, step = W / count;
        let d = `M0,72`;
        for (let i = 1; i <= count; i++) {
            const y = 72 - i * 7;
            d += ` L${((i - 1) * step).toFixed(1)},${y} L${(i * step).toFixed(1)},${y}`;
        }
        return d + ` L${W},${H} L0,${H} Z`;
    };

    const scallop = () => {
        const count = 12, r = W / count;
        let d = `M0,54`;
        for (let i = 0; i < count; i++) {
            d += ` A${r / 2},${r / 2} 0 0,${i % 2 === 0 ? 1 : 0} ${(i + 1) * r},54`;
        }
        return d + ` L${W},${H} L0,${H} Z`;
    };

    const SHAPES = { wave, zigzag, diagonal, steps, scallop };

    dividers.forEach((el, index) => {
        const build = SHAPES[el.dataset.shape] || wave;
        const path = build();
        const bg = solidBg(el.previousElementSibling) || el.dataset.bg || '#ffffff';
        const fill = solidBg(el.nextElementSibling) || el.dataset.fill || bg;
        const c1 = el.dataset.c1 || '#FF8950';
        const c2 = el.dataset.c2 || '#C191FF';
        const gid = `dv-grad-${index}`;

        el.style.background = bg;
        el.innerHTML =
            `<svg viewBox="0 0 ${W} ${H + BAND}" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">` +
            `<defs><linearGradient id="${gid}" x1="0" y1="0" x2="1" y2="0">` +
            `<stop offset="0%" stop-color="${c1}"/><stop offset="100%" stop-color="${c2}"/>` +
            `</linearGradient></defs>` +
            `<path d="${path}" fill="url(#${gid})" opacity="0.9"/>` +
            `<path d="${path}" fill="url(#${gid})" opacity="0.28" transform="translate(0,7)"/>` +
            `<path d="${path}" fill="${fill}" transform="translate(0,${BAND})"/>` +
            `</svg>`;
    });
}

/* --------------------------------------------------------------------------
   SplitText-style word reveal on headings
   -------------------------------------------------------------------------- */
function initSplitHeadings() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const targets = document.querySelectorAll(
        '.section-heading, .hero-headline, .service-row-heading, .contact-heading, .footer-cta-line'
    );
    if (!targets.length) return;

    targets.forEach(heading => {
        const groups = [];
        const collect = (node) => {
            node.childNodes.forEach(child => {
                if (child.nodeType === Node.TEXT_NODE) {
                    const tokens = child.textContent.split(/\s+/).filter(Boolean);
                    if (tokens.length && child.parentNode) groups.push({ node: child, tokens });
                } else if (child.nodeType === Node.ELEMENT_NODE && !child.classList.contains('split-word')) {
                    collect(child);
                }
            });
        };
        collect(heading);
        if (!groups.length) return;

        let index = 0;
        groups.forEach(group => {
            const frag = document.createDocumentFragment();
            group.tokens.forEach(token => {
                const outer = document.createElement('span');
                outer.className = 'split-word';
                const inner = document.createElement('span');
                inner.className = 'split-inner';
                inner.style.setProperty('--wd', `${(index++) * 55}ms`);
                inner.textContent = token;
                outer.appendChild(inner);
                frag.appendChild(outer);
                frag.appendChild(document.createTextNode(' '));
            });
            const textNode = group.node;
            textNode.parentNode.insertBefore(frag, textNode);
            textNode.textContent = '';
        });

        heading.classList.add('has-split');

        if (!('IntersectionObserver' in window)) {
            heading.classList.add('split-done');
            return;
        }

        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('split-done');
                obs.unobserve(entry.target);
            });
        }, { threshold: 0.35 });
        observer.observe(heading);
    });
}

/* --------------------------------------------------------------------------
   Hand-drawn line art: stroke-by-stroke draw-in
   -------------------------------------------------------------------------- */
function initDoodles() {
    const doodles = document.querySelectorAll('.doodle');
    if (!doodles.length) return;

    doodles.forEach(doodle => {
        doodle.querySelectorAll('.dl, .dot').forEach((el, i) => {
            el.style.setProperty('--dd', `${i * 85}ms`);
        });
    });

    if (!('IntersectionObserver' in window)) {
        doodles.forEach(doodle => doodle.classList.add('drawn'));
        return;
    }

    const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('drawn');
            obs.unobserve(entry.target);
        });
    }, { threshold: 0.25, rootMargin: '0px 0px -20px 0px' });

    doodles.forEach(doodle => observer.observe(doodle));
}

/* --------------------------------------------------------------------------
   Our Work — category filtering
   -------------------------------------------------------------------------- */
function initWorkFilters() {
    const buttons = document.querySelectorAll('.work-filter');
    const cards = document.querySelectorAll('.work-card');
    if (!buttons.length || !cards.length) return;

    buttons.forEach(btn => {
        btn.addEventListener('click', () => {
            const filter = btn.getAttribute('data-filter');
            buttons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            cards.forEach(card => {
                const match = filter === 'all' || card.getAttribute('data-cat') === filter;
                card.classList.toggle('is-hidden', !match);
            });
        });
    });
}

/* --------------------------------------------------------------------------
   Service ecosystem — draw hub -> node links, then switch on the live state
   -------------------------------------------------------------------------- */
function initEcosystem() {
    const container = document.querySelector('.ecosystem-container');
    if (!container) return;

    const svg = container.querySelector('.eco-links');
    const hub = container.querySelector('.hub-circle');
    const nodes = container.querySelectorAll('.eco-node');
    const NS = 'http://www.w3.org/2000/svg';

    const draw = () => {
        if (!svg || !hub || !nodes.length) return;
        const box = container.getBoundingClientRect();
        if (box.width < 10) return;

        svg.innerHTML = '';
        svg.setAttribute('viewBox', `0 0 ${box.width.toFixed(0)} ${box.height.toFixed(0)}`);

        const center = (el) => {
            const r = el.getBoundingClientRect();
            return {
                x: r.left - box.left + r.width / 2,
                y: r.top - box.top + r.height / 2,
                top: r.top - box.top,
                bottom: r.bottom - box.top
            };
        };
        const hubPt = center(hub);

        nodes.forEach((node, i) => {
            const pt = center(node);
            const line = document.createElementNS(NS, 'line');
            line.setAttribute('x1', hubPt.x.toFixed(1));
            line.setAttribute('y1', hubPt.bottom.toFixed(1));
            line.setAttribute('x2', pt.x.toFixed(1));
            line.setAttribute('y2', Math.max(pt.top, hubPt.top).toFixed(1));
            line.style.animationDelay = `${i * 0.16}s`;
            svg.appendChild(line);
        });
    };

    draw();
    let raf = null;
    window.addEventListener('resize', () => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(draw);
    }, { passive: true });

    if (!('IntersectionObserver' in window)) {
        container.classList.add('is-live');
        return;
    }
    const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            container.classList.add('is-live');
            draw();
            obs.unobserve(entry.target);
        });
    }, { threshold: 0.2 });
    observer.observe(container);
}

/* --------------------------------------------------------------------------
   Hero "strings" stage - word chips hung on hairlines, swaying + draggable
   -------------------------------------------------------------------------- */
function initHeroStrings() {
    const stage = document.getElementById('stringsStage');
    if (!stage) return;
    const svg = stage.querySelector('[data-strings]');
    const chips = Array.from(stage.querySelectorAll('.string-chip'));
    if (!svg || !chips.length) return;

    const isWide = () => window.matchMedia('(min-width: 901px)').matches;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v, lo, hi) => Math.min(Math.max(v, lo), hi);

    const items = chips.map((el, i) => ({
        el,
        fx: parseFloat(el.style.getPropertyValue('--fx')) || 0,
        fy: parseFloat(el.style.getPropertyValue('--fy')) || 0,
        sd: parseFloat(el.style.getPropertyValue('--sd')) || 0,
        bx: 0,
        by: 0,
        ox: 0,
        oy: 0,
        w: 0,
        h: 0,
        edge: 'left',
        amp: 0.65 + (i % 4) * 0.4,
        phase: i * 0.9,
        depth: 0.45 + (i % 3) * 0.3,
        px: 0,
        py: 0,
        grow: 0,
        start: -1,
        scale: 0,
        drag: false
    }));

    const lines = items.map((it) => {
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        if (it.el.hasAttribute('data-key')) line.classList.add('is-key');
        svg.appendChild(line);
        return line;
    });

    // short links between neighbouring chips in the same row, with square nodes
    const connectors = [];
    const rows = {};
    items.forEach((it, i) => {
        const r = it.el.dataset.row || '1';
        (rows[r] = rows[r] || []).push(i);
    });
    Object.keys(rows).forEach(r => {
        const group = rows[r].sort((a, b) => items[a].fx - items[b].fx);
        for (let i = 0; i < group.length - 1; i++) {
            const link = { a: group[i], b: group[i + 1], line: document.createElementNS('http://www.w3.org/2000/svg', 'line'), nodes: [] };
            link.line.setAttribute('class', 'is-conn');
            svg.appendChild(link.line);
            for (let n = 0; n < 2; n++) {
                const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
                rect.setAttribute('class', 'is-node');
                rect.setAttribute('width', '4');
                rect.setAttribute('height', '4');
                svg.appendChild(rect);
                link.nodes.push(rect);
            }
            connectors.push(link);
        }
    });

    let rafId = null;
    let visible = true;

    function measure() {
        if (!isWide()) {
            items.forEach(it => { it.el.style.transform = ''; it.el.style.left = ''; it.el.style.top = ''; });
            return;
        }
        const W = stage.clientWidth;
        const H = stage.clientHeight;
        items.forEach(it => {
            it.w = it.el.offsetWidth;
            it.h = it.el.offsetHeight;
            it.bx = clamp(it.fx * W, 0, Math.max(0, W - it.w));
            it.by = clamp(it.fy * H, 0, Math.max(0, H - it.h));
            it.edge = (it.bx + it.w / 2) < W / 2 ? 'left' : 'right';
            it.el.style.left = it.bx + 'px';
            it.el.style.top = it.by + 'px';
        });
    }

    let pointerX = 0;
    let pointerY = 0;

    stage.addEventListener('pointermove', ev => {
        const r = stage.getBoundingClientRect();
        if (!r.width || !r.height) return;
        pointerX = ((ev.clientX - r.left) / r.width - 0.5) * 2;
        pointerY = ((ev.clientY - r.top) / r.height - 0.5) * 2;
    });
    stage.addEventListener('pointerleave', () => { pointerX = 0; pointerY = 0; });

    function paint() {
        const W = stage.clientWidth;
        const H = stage.clientHeight;
        items.forEach((it, i) => {
            const line = lines[i];
            const ax = it.bx + it.ox + it.px;
            const ay = it.by + it.oy + it.py;
            it._ax = ax;
            it._ay = ay + it.h / 2;
            it._left = ax;
            it._right = ax + it.w;
            const attachX = it.edge === 'left' ? ax : ax + it.w;
            const attachY = ay + it.h / 2;
            const edgeY = clamp(attachY + it.sd * H, 6, Math.max(6, H - 6));
            const edgeX = it.edge === 'left' ? 0 : W;
            const g = it.grow;
            line.setAttribute('x1', edgeX.toFixed(1));
            line.setAttribute('y1', edgeY.toFixed(1));
            line.setAttribute('x2', (edgeX + (attachX - edgeX) * g).toFixed(1));
            line.setAttribute('y2', (edgeY + (attachY - edgeY) * g).toFixed(1));
        });
        connectors.forEach(c => {
            const a = items[c.a];
            const b = items[c.b];
            const x1 = a._right;
            const x2 = b._left;
            const y1 = a._ay;
            const y2 = b._ay;
            c.line.setAttribute('x1', x1.toFixed(1));
            c.line.setAttribute('y1', y1.toFixed(1));
            c.line.setAttribute('x2', x2.toFixed(1));
            c.line.setAttribute('y2', y2.toFixed(1));
            c.nodes[0].setAttribute('x', (x1 - 2).toFixed(1));
            c.nodes[0].setAttribute('y', (y1 - 2).toFixed(1));
            c.nodes[1].setAttribute('x', (x2 - 2).toFixed(1));
            c.nodes[1].setAttribute('y', (y2 - 2).toFixed(1));
        });
    }

    function place(now) {
        items.forEach(it => {
            let sx = 0;
            let sy = 0;
            if (!reduced && !it.drag && it.scale >= 1) {
                sx = Math.sin(now * 0.0009 + it.phase) * 2.2 * it.amp;
                sy = Math.cos(now * 0.00115 + it.phase * 1.4) * 2.9 * it.amp;
            }
            it.el.style.transform = 'translate3d(' + (it.ox + it.px + sx).toFixed(2) + 'px,' + (it.oy + it.py + sy).toFixed(2) + 'px,0) scale(' + it.scale.toFixed(3) + ')';
        });
        paint();
    }

    function frame(now) {
        let alive = false;
        items.forEach(it => {
            if (it.start >= 0 && it.scale < 1) {
                const t = (now - it.start) / 620;
                if (t >= 1) {
                    it.scale = 1;
                } else if (t > 0) {
                    it.scale = 1 + 2.2 * Math.pow(t - 1, 3) + 1.2 * Math.pow(t - 1, 2);
                    alive = true;
                } else {
                    alive = true;
                }
                it.el.classList.add('pop');
            }
            if (it.start >= 0 && it.grow < 1) {
                const gt = (now - it.start - 90) / 560;
                it.grow = gt <= 0 ? 0 : 1 - Math.pow(1 - Math.min(1, gt), 3);
                if (it.grow >= 1) it.grow = 1;
                else alive = true;
            }
            if (!reduced) {
                const tx = pointerX * 9 * it.depth;
                const ty = pointerY * 7 * it.depth;
                if (Math.abs(tx - it.px) > 0.05 || Math.abs(ty - it.py) > 0.05) {
                    it.px += (tx - it.px) * 0.07;
                    it.py += (ty - it.py) * 0.07;
                    alive = true;
                } else {
                    it.px = tx;
                    it.py = ty;
                }
            }
            if (!it.drag && (Math.abs(it.ox) > 0.15 || Math.abs(it.oy) > 0.15)) {
                it.ox *= 0.9;
                it.oy *= 0.9;
                alive = true;
            } else if (!it.drag) {
                it.ox = 0;
                it.oy = 0;
            }
            if (it.drag) alive = true;
        });
        if (!reduced) {
            const shift = Math.max(-34, -window.scrollY * 0.035);
            stage.style.transform = 'translate3d(0,' + shift.toFixed(1) + 'px,0)';
        }
        place(now);
        if (visible && (alive || !reduced)) {
            rafId = requestAnimationFrame(frame);
        } else {
            rafId = null;
        }
    }

    function begin() {
        if (stage.classList.contains('is-live')) return;
        stage.classList.add('is-live');
        measure();
        if (reduced) {
            items.forEach(it => { it.scale = 1; it.grow = 1; it.el.classList.add('pop'); });
            place(performance.now());
            return;
        }
        const t0 = performance.now();
        items.forEach((it, i) => { it.start = t0 + i * 70; });
        if (rafId === null) rafId = requestAnimationFrame(frame);
    }

    function bind(it) {
        it.el.addEventListener('pointerdown', ev => {
            if (!isWide() || it.scale < 0.9) return;
            ev.preventDefault();
            it.el.setPointerCapture(ev.pointerId);
            it.el.classList.add('is-dragging');
            it.drag = true;
            it.scale = 1.05;
            const sx = ev.clientX;
            const sy = ev.clientY;
            const o0 = it.ox;
            const o1 = it.oy;
            const W = stage.clientWidth;
            const H = stage.clientHeight;
            const move = mv => {
                it.ox = clamp(o0 + (mv.clientX - sx), -it.bx, Math.max(0, W - it.bx - it.w));
                it.oy = clamp(o1 + (mv.clientY - sy), -it.by, Math.max(0, H - it.by - it.h));
            };
            const up = () => {
                it.el.classList.remove('is-dragging');
                it.drag = false;
                it.scale = 1;
                it.el.removeEventListener('pointermove', move);
                it.el.removeEventListener('pointerup', up);
                it.el.removeEventListener('pointercancel', up);
            };
            it.el.addEventListener('pointermove', move);
            it.el.addEventListener('pointerup', up);
            it.el.addEventListener('pointercancel', up);
        });
    }

    items.forEach(bind);

    window.addEventListener('resize', () => {
        if (!stage.classList.contains('is-live')) return;
        measure();
        items.forEach(it => { it.ox = 0; it.oy = 0; });
        place(performance.now());
    });

    measure();
    if ('IntersectionObserver' in window) {
        const obs = new IntersectionObserver((entries, o) => {
            entries.forEach(entry => {
                if (!entry.isIntersecting) return;
                begin();
                o.unobserve(entry.target);
            });
        }, { threshold: 0.12 });
        obs.observe(stage);
        const vis = new IntersectionObserver(entries => {
            entries.forEach(entry => {
                visible = entry.isIntersecting;
                if (visible && stage.classList.contains('is-live') && !reduced && rafId === null) rafId = requestAnimationFrame(frame);
            });
        }, { threshold: 0 });
        vis.observe(stage);
    } else {
        begin();
    }
}

/* --------------------------------------------------------------------------
   Services sticky index - highlights the row currently in view
   -------------------------------------------------------------------------- */
function initServiceIndex() {
    const links = Array.from(document.querySelectorAll('.svc-index-link'));
    const rows = links
        .map(link => document.getElementById(link.dataset.svcRow))
        .filter(row => !!row);
    if (!links.length || !rows.length) return;

    function setActive(row) {
        links.forEach(link => link.classList.toggle('is-active', link.dataset.svcRow === row.id));
        rows.forEach(r => r.classList.toggle('is-active', r === row));
    }

    setActive(rows[0]);

    links.forEach(link => {
        link.addEventListener('click', () => {
            const row = rows.find(r => r.id === link.dataset.svcRow);
            if (row) setActive(row);
        });
    });

    if (!('IntersectionObserver' in window)) return;

    const visible = new Map();
    const obs = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) visible.set(entry.target, entry.intersectionRatio);
            else visible.delete(entry.target);
        });
        if (!visible.size) return;
        let best = null;
        let bestRatio = -1;
        visible.forEach((ratio, el) => {
            if (ratio > bestRatio) { bestRatio = ratio; best = el; }
        });
        if (best) setActive(best);
    }, { threshold: [0, 0.25, 0.5, 0.75], rootMargin: '-15% 0px -30% 0px' });

    rows.forEach(row => obs.observe(row));
}

/* --------------------------------------------------------------------------
   Clients band: duplicate the set so the hairline strip can loop seamlessly
   -------------------------------------------------------------------------- */
function initBrandBand() {
    const row = document.querySelector('.brand-band-row');
    if (!row) return;

    Array.from(row.querySelectorAll('.brand-cell')).forEach(cell => {
        const clone = cell.cloneNode(true);
        clone.classList.add('is-clone');
        clone.setAttribute('aria-hidden', 'true');
        clone.querySelectorAll('a, button').forEach(el => el.setAttribute('tabindex', '-1'));
        row.appendChild(clone);
    });
}
